{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "protocol/types.ts",
    "packages/core/src/**/*.ts",
    "packages/core/test/**/*.ts",
    "packages/quality/src/**/*.ts",
    "packages/quality/test/**/*.ts",
    "packages/test-utils/src/**/*.ts",
    "packages/test-utils/test/**/*.ts",
    "packages/transport/src/**/*.ts",
    "packages/transport/test/**/*.ts",
    "packages/server/src/**/*.ts",
    "packages/server/test/**/*.ts",
    "packages/sfu-gateway/src/**/*.ts",
    "packages/sfu-gateway/test/**/*.ts"
  ]
}
