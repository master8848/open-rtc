{
  "name": "@mbsks/openrtc-backend-supabase",
  "version": "0.1.0",
  "description": "vidcall signaling backend adapter for Supabase Realtime (broadcast + presence) \u2014 the default backend.",
  "author": "Saurav Sanjel <jobarsanjel2@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.9",
    "@mbsks/openrtc-protocol": "0.1.0",
    "@mbsks/openrtc-transport": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
