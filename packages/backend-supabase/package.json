{
  "name": "@vidcall/backend-supabase",
  "version": "0.1.0",
  "description": "vidcall signaling backend adapter for Supabase Realtime (broadcast + presence) \u2014 the default backend.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.9",
    "@vidcall/transport": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
