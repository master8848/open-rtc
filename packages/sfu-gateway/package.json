{
  "name": "@mbsks/openrtc-sfu-gateway",
  "version": "0.1.0",
  "description": "vidcall SFU gateway: transport-agnostic SfuGateway interface + SfuRouter (protocol sfu-envelope handling, pure logic) + reference mediasoup adapter. Mesh -> SFU at scale (docs/architecture.md D2); Room integration TODO.",
  "author": "Saurav Sanjel <jobarsanjel2@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./mediasoup": {
      "types": "./dist/mediasoup-adapter.d.ts",
      "import": "./dist/mediasoup-adapter.js",
      "require": "./dist/mediasoup-adapter.cjs",
      "development": "./src/mediasoup-adapter.ts",
      "default": "./dist/mediasoup-adapter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean",
    "test": "node --conditions=development --test \"test/*.test.ts\"",
    "test:integration": "VIDCALL_MEDIASOUP_INTEGRATION=1 node --conditions=development --test test/integration.mediasoup.test.ts"
  },
  "dependencies": {
    "@mbsks/openrtc-protocol": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "mediasoup": "3.23.1",
    "typescript": "7.0.2"
  }
}
