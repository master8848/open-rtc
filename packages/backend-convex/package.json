{
  "name": "@vidcall/backend-convex",
  "version": "0.1.0",
  "description": "vidcall signaling backend adapter for Convex (mutations + live queries; signals table + presence table pattern).",
  "author": "Saurav Sanjel <jobarsanjel2@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "convex"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "convex": "1.42.3",
    "@vidcall/protocol": "0.1.0",
    "@vidcall/transport": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
