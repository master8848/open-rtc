{
  "name": "@vidcall/react",
  "version": "0.1.0",
  "description": "vidcall React bindings: useSyncExternalStore hooks over @vidcall/core's Room snapshot layer (useRoomState, useParticipants, useJoin). StrictMode-safe.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@vidcall/core": "0.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vidcall/test-utils": "0.1.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
