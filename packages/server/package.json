{
  "name": "@vidcall/server",
  "version": "0.1.0",
  "description": "vidcall server component: ROOM/SESSION state, signaling relay and recording storage that any app backend can host (Express/Fastify natively; Django/Laravel/Rails via REST/WS). Function-based Store interface works with any database.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./shared-tests": {
      "types": "./dist/shared-tests.d.ts",
      "development": "./src/shared-tests.ts",
      "default": "./dist/shared-tests.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean",
    "test": "node --conditions=development --test test/*.test.ts"
  },
  "dependencies": {
    "@vidcall/protocol": "0.1.0",
    "better-sqlite3": "13.0.1",
    "mysql2": "3.23.2",
    "pg": "8.22.0",
    "ws": "8.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.1",
    "express": "5.2.1",
    "fastify": "5.10.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "express": "^5.2.1",
    "fastify": "^5.10.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}
