{
  "name": "@mbsks/openrtc-quality",
  "version": "0.1.0",
  "description": "vidcall adaptive quality policy engine: DeviceCapability + AdaptiveQualityController (pure; consumes RTCStatsSnapshot, no WebRTC imports).",
  "author": "Saurav Sanjel <jobarsanjel2@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@mbsks/openrtc-protocol": "0.1.0"
  }
}
