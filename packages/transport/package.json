{
  "name": "@mbsks/openrtc-transport",
  "version": "0.1.0",
  "description": "vidcall signaling transport contract (structural twin of @mbsks/openrtc-core SignalingTransport) + helpers: chunker, reorder buffer, heartbeat, ICE coalescer, InMemoryBackend, shared adapter test suite.",
  "author": "Saurav Sanjel <jobarsanjel2@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "development": "./src/internal/index.ts",
      "default": "./dist/internal/index.js"
    },
    "./shared-tests": {
      "types": "./dist/shared-tests.d.ts",
      "development": "./src/shared-tests.ts",
      "default": "./dist/shared-tests.js"
    },
    "./composite": {
      "types": "./dist/composite.d.ts",
      "development": "./src/composite.ts",
      "default": "./dist/composite.js"
    },
    "./reconnecting": {
      "types": "./dist/reconnecting.d.ts",
      "development": "./src/reconnecting.ts",
      "default": "./dist/reconnecting.js"
    },
    "./web-transport": {
      "types": "./dist/web-transport.d.ts",
      "development": "./src/web-transport.ts",
      "default": "./dist/web-transport.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@mbsks/openrtc-protocol": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
