{
  "name": "@vidcall/transport",
  "version": "0.1.0",
  "description": "vidcall signaling transport contract (structural twin of @vidcall/core SignalingTransport) + helpers: chunker, reorder buffer, heartbeat, ICE coalescer, InMemoryBackend, shared adapter test suite.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "development": "./src/internal/index.ts",
      "default": "./dist/internal/index.js"
    },
    "./shared-tests": {
      "types": "./dist/shared-tests.d.ts",
      "development": "./src/shared-tests.ts",
      "default": "./dist/shared-tests.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@vidcall/protocol": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
