{
  "name": "@mbsks/openrtc-test-utils",
  "version": "0.1.0",
  "description": "vidcall test utilities: fake RTCPeerConnection / tracks / data channels and envelope fixtures for engine and policy tests. Zero runtime dependencies.",
  "author": "Saurav Sanjel <jobarsanjel2@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@mbsks/openrtc-protocol": "0.1.0"
  }
}
