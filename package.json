{
  "name": "vidcall",
  "version": "0.1.0",
  "private": true,
  "description": "JS/TS video-calling library: mesh WebRTC engine, adaptive quality, pluggable signaling backends, shared wire protocol.",
  "author": "Saurav Sanjel <jobarsanjel2@gmail.com>",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "protocol"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/post-build-cjs.mjs || true",
    "changeset": "changeset",
    "clean": "tsc -b --clean",
    "test": "node --conditions=development --test \"protocol/test/*.test.ts\" \"packages/core/test/*.test.ts\" \"packages/quality/test/*.test.ts\" \"packages/test-utils/test/*.test.ts\" \"packages/server/test/*.test.ts\" \"packages/sfu-gateway/test/*.test.ts\"",
    "test:sfu": "node --conditions=development --test \"packages/sfu-gateway/test/*.test.ts\"",
    "test:sfu:integration": "VIDCALL_MEDIASOUP_INTEGRATION=1 node --conditions=development --test packages/sfu-gateway/test/integration.mediasoup.test.ts",
    "test:transport": "cd packages/transport && vitest run",
    "test:react": "cd packages/react && vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "oxlint protocol packages/core packages/quality packages/test-utils packages/transport packages/server packages/sfu-gateway packages/react && oxfmt --check protocol packages/core packages/quality packages/test-utils packages/transport packages/server packages/sfu-gateway packages/react package.json tsconfig.base.json tsconfig.json tsconfig.test.json .oxlintrc.json .oxfmtrc.json",
    "format": "oxfmt protocol packages/core packages/quality packages/test-utils packages/transport packages/server packages/sfu-gateway packages/react package.json tsconfig.base.json tsconfig.json tsconfig.test.json .oxlintrc.json .oxfmtrc.json",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "test:server": "node --conditions=development --test \"packages/server/test/*.test.ts\"",
    "test:server:pg": "VIDCALL_TEST_POSTGRES_URL=postgres://vidcall:vidcall@127.0.0.1:5433/vidcall_test node --conditions=development --test packages/server/test/PostgresStore.test.ts",
    "test:server:mysql": "VIDCALL_TEST_MYSQL_URL=mysql://vidcall:vidcall@127.0.0.1:3307/vidcall_test node --conditions=development --test packages/server/test/MysqlStore.test.ts",
    "verify:links": "bun run scripts/verify-links.ts",
    "verify:budgets": "node scripts/verify-budgets.mjs",
    "verify:docs": "bun run verify:links && node scripts/verify-budgets.mjs",
    "llms:generate": "node scripts/llms-generate.mjs",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test:build": "bun run build && publint --pack && attw --pack",
    "size": "size-limit",
    "size:core": "bun run size",
    "publint": "publint --pack",
    "attw": "attw --pack",
    "check:sherif": "sherif",
    "check:knip": "knip",
    "check:zizmor": "zizmor .github/workflows",
    "check:quality": "bun run check:sherif && bun run check:knip && bun run check:zizmor",
    "affected": "bun run build",
    "changeset:dry-run": "changeset status --verbose 2>&1 | head -n 80; echo 'dry-run gate: changeset status (plans/07-roadmap.md:77 version --dry-run intent)'"
  },
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/cli": "3.0.0",
    "@size-limit/preset-small-lib": "^11.1.2",
    "@types/node": "22.20.1",
    "knip": "^5.72.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "publint": "^0.3.12",
    "sherif": "^1.4.1",
    "size-limit": "^11.1.2",
    "typescript": "7.0.2"
  }
}
